#CONFIG_MULTIUSER=y
#CONFIG_NAMESPACES=y
#CONFIG_SYSVIPC=y
#CONFIG_SYSVIPC_SYSCTL=y
#CONFIG_POSIX_MQUEUE=y
#CONFIG_IPC_NS=y

# --- 2. BADUSB & HID GADGET ---
#CONFIG_USB_CONFIGFS_F_HID=y
#CONFIG_USB_CONFIGFS_F_UVC=y

# --- 3. USB ETHERNET & TETHERING ---
#CONFIG_USB_NET_DRIVERS=y
#CONFIG_USB_USBNET=y
#CONFIG_USB_NET_CDC_EEM=y
#CONFIG_USB_NET_CDC_MBIM=y

# --- 4. BLUETOOTH & RFKILL PENTESTING ---
#CONFIG_BT=y
#CONFIG_BT_HCIBTUSB=y
#CONFIG_BT_HCIUART=y
#CONFIG_BT_HCIUART_H4=y

# --- 5. NETHUNTER TESTING TOOLS ---
#CONFIG_NET_PKTGEN=y

# --- 6. CORE WIRELESS & WEXT (REQUIRED FOR REALTEK) ---
